EMCC = $(HOME)/emsdk/upstream/emscripten/emcc

TARGET = demo

all: $(TARGET).js

$(TARGET).js: demo.cpp
	$(EMCC) -std=c++17 -O2 \
		--bind \
		-s WASM=1 \
		-s MODULARIZE=1 \
		-s EXPORT_NAME="Demo" \
		-s ALLOW_MEMORY_GROWTH=1 \
		-s ENVIRONMENT='web,node' \
		-o $(TARGET).js \
		demo.cpp
	@echo "✓ 生成: $(TARGET).js + $(TARGET).wasm"

clean:
	rm -f $(TARGET).js $(TARGET).wasm

.PHONY: all clean
